# Copy this file to .env and fill in real values. .env is never committed.

# Long random value used to sign sessions. Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# True only on your own laptop while developing. Must be False on a real server.
DJANGO_DEBUG=True

# The web addresses the app answers to (comma-separated). Optional on your laptop.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# True only on a real server with an HTTPS certificate: turns on secure cookies,
# the HTTP-to-HTTPS redirect and HSTS.
DJANGO_HTTPS=False
